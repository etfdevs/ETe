# Generate shader_data.c (and optionally shader_binding.c) from compiled
# SPIR-V files.
#
# Invoked at build time by add_vulkan_shader_generation() from
# cmake/utils/vulkan_shaders.cmake. Inputs are passed with -D:
#
#   VK_SHADER_OUTPUT_DIR       directory containing the spv/ subdirectory
#   VK_SHADER_DATA_FILE        output shader_data.c
#   VK_SHADER_BINDING_FILE     output shader_binding.c
#   VK_SHADER_GENERATE_BINDINGS generate shader_binding.c (default OFF)
#   VK_SHADER_TASKS            list of <name>|<input>|<stage>|<defines>|<binding>

foreach(required VK_SHADER_OUTPUT_DIR VK_SHADER_DATA_FILE)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "generate_vulkan_shader_data.cmake: ${required} is not set")
    endif()
endforeach()

if(NOT DEFINED VK_SHADER_TASKS)
    message(FATAL_ERROR "generate_vulkan_shader_data.cmake: VK_SHADER_TASKS is not set")
endif()

if(NOT DEFINED VK_SHADER_GENERATE_BINDINGS)
    set(VK_SHADER_GENERATE_BINDINGS OFF)
endif()

if(VK_SHADER_GENERATE_BINDINGS AND NOT DEFINED VK_SHADER_BINDING_FILE)
    message(FATAL_ERROR "generate_vulkan_shader_data.cmake: VK_SHADER_BINDING_FILE is not set")
endif()

set(data)
string(APPEND data "// This file is generated by cmake/utils/generate_vulkan_shader_data.cmake.\n")
string(APPEND data "// Do not edit; edit the GLSL sources in src/renderervk/shaders instead.\n\n")

if(VK_SHADER_GENERATE_BINDINGS)
    set(bindings)
    string(APPEND bindings "// This file is generated by cmake/utils/generate_vulkan_shader_data.cmake.\n")
    string(APPEND bindings "// Do not edit; edit the GLSL sources in src/renderervk/shaders instead.\n")
    string(APPEND bindings "static void vk_set_shader_name( VkShaderModule shader, const char *name ) {\n")
    string(APPEND bindings "    VK_SET_OBJECT_NAME( shader, name, VK_DEBUG_REPORT_OBJECT_TYPE_SHADER_MODULE_EXT );\n")
    string(APPEND bindings "}\n")
    string(APPEND bindings "void vk_bind_generated_shaders( void ) {\n")
    set(bound_count 0)
endif()

foreach(task IN LISTS VK_SHADER_TASKS)
    string(REPLACE "|" ";" fields "${task}")
    list(GET fields 0 name)
    list(GET fields 4 binding)

    set(spv "${VK_SHADER_OUTPUT_DIR}/spv/${name}.spv")
    if(NOT EXISTS "${spv}")
        message(FATAL_ERROR "generate_vulkan_shader_data.cmake: missing ${spv}")
    endif()

    file(READ "${spv}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")

    # Split the hex string into 0xNN tokens. Each token is 6 characters
    # ("0xNN, "), so 16 bytes per line is a 96 character slice.
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " bytes "${hex}")
    string(REGEX REPLACE ", $" "" bytes "${bytes}")

    set(index 0)
    set(lines)
    while(index LESS size)
        math(EXPR remaining "${size} - ${index}")
        if(remaining GREATER 16)
            set(chunk 16)
        else()
            set(chunk ${remaining})
        endif()

        math(EXPR start "${index} * 6")
        math(EXPR length "${chunk} * 6")
        string(SUBSTRING "${bytes}" ${start} ${length} line)
        string(APPEND lines "\t${line}\n")
        math(EXPR index "${index} + ${chunk}")
    endwhile()

    string(APPEND data "const unsigned char ${name}[${size}] = {\n${lines}};\n\n")

    if(VK_SHADER_GENERATE_BINDINGS AND NOT binding STREQUAL "-")
        string(APPEND bindings "    ${binding} = SHADER_MODULE( ${name} );\n")
        string(APPEND bindings "    vk_set_shader_name( ${binding}, \"${name}\" );\n")
        math(EXPR bound_count "${bound_count} + 1")
    endif()
endforeach()

file(WRITE "${VK_SHADER_DATA_FILE}" "${data}")

if(VK_SHADER_GENERATE_BINDINGS)
    string(APPEND bindings "}\n")
    file(WRITE "${VK_SHADER_BINDING_FILE}" "${bindings}")
    message(STATUS "Generated ${VK_SHADER_DATA_FILE} (${bound_count} bindings)")
else()
    message(STATUS "Generated ${VK_SHADER_DATA_FILE}")
endif()
